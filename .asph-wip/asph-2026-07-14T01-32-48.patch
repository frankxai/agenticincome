++    { tool: 'Pollo AI', verdict: 'Aggregator — fronts Sora, Veo, Kling, and Hailuo behind one payable link when you specifically need one of those models.', price: 'Varies by model used', recurring: 'Direct program, terms not yet confirmed' },
