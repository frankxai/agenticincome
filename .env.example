# Agentic Income — environment reference.
# Copy to .env.local for local work. Never commit a filled-in copy.
# Everything here is optional: with none of it set, the site runs and every
# commercial surface renders its honest "not connected" state rather than a
# fake one.

# --- Intake and telemetry -----------------------------------------------
# Delivery service webhook for the email intake. Unset -> the route answers
# 'unwired' and is recorded as subscribe_unwired, never as a success.
SUBSCRIBE_WEBHOOK_URL=
# Concierge address used to build a mailto fallback when no webhook exists.
ACCESS_REQUEST_EMAIL=
# Server-side sink for the allowlisted analytics events in lib/analytics.ts.
ANALYTICS_WEBHOOK_URL=

# --- Checkout path A: static Polar checkout links ------------------------
# Used by GET /api/checkout via lib/offers.ts (`checkout.envKey`). Paste the
# checkout link Polar gives you per product. Missing -> the route redirects to
# the offer's request-access section instead of pretending checkout exists.
AGENTIC_INCOME_BLUEPRINT_CHECKOUT_URL=
AGENTIC_INCOME_PRIVATE_INTEL_CHECKOUT_URL=
AGENTIC_INCOME_AGENT_TEAM_PRO_CHECKOUT_URL=

# --- Checkout path B: Polar API sessions (preferred) ---------------------
# Used by POST /api/checkout via lib/polar.ts. Creates a real checkout session
# per click, so the success URL is set from the catalog rather than baked into
# a copied link. See ops/POLAR-SETUP.md before setting any of these.
#
# Setting these alone does NOT open checkout: products/catalog.json `status`
# must also start with "for sale" for that product. By design.

# Organization Access Token (Polar dashboard -> Settings -> Developers).
# Server-side only. Never prefix with NEXT_PUBLIC_.
POLAR_ACCESS_TOKEN=

# One Polar product id per sellable catalog entry. The catalog-id -> env-var
# mapping lives in lib/polar.ts (PRODUCT_ID_ENV_KEYS); an unmapped product can
# never be checked out. `starter-kit` is absent on purpose — it is free.
#   blueprint       ($67 one-time)
POLAR_PRODUCT_ID_BLUEPRINT=
#   private-intel   ($19/mo subscription)
POLAR_PRODUCT_ID_PRIVATE_INTEL=
#   agent-team-pro  ($129 — do not set until the payload is assembled)
POLAR_PRODUCT_ID_AGENT_TEAM_PRO=

# Site origin used to build each product's success URL. The path comes from the
# catalog's own `delivery.path`, so buyers land on the delivery desk for the
# product they bought (e.g. https://agenticincome.ai/delivery/blueprint).
# Must be https. Unset -> Polar's own confirmation page is used.
POLAR_SUCCESS_URL=
