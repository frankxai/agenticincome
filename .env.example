# Agentic Income — environment reference.
# Copy to .env.local for local work. Never commit a filled-in copy.
# Everything here is optional: with none of it set, the site runs and every
# commercial surface renders its honest "not connected" state rather than a
# fake one.

# --- Intake and telemetry -----------------------------------------------
# Delivery service webhook for the email intake. Unset -> the route answers
# 'unwired' and is recorded as subscribe_unwired, never as a success.
SUBSCRIBE_WEBHOOK_URL=
# Concierge address used to build a mailto fallback when no webhook exists.
ACCESS_REQUEST_EMAIL=
# Server-side sink for the allowlisted analytics events in lib/analytics.ts.
ANALYTICS_WEBHOOK_URL=

# --- Commerce kit (lib/commerce/, docs/COMMERCE.md) -----------------------
# GET /api/checkout opens a hosted checkout only when BOTH gates hold:
#   1. products/catalog.json `status` starts with "for sale", AND
#   2. COMMERCE_PROVIDER names a provider that is configured for the product.
# Unset/unknown COMMERCE_PROVIDER = `none` = closed. Setting it in Production
# is the owner's release approval — do not set it without that approval.
#   stripe | payment_link | polar | none
COMMERCE_PROVIDER=
# Any of 1/true/yes/on closes EVERY checkout path (GET, Polar POST, page CTAs).
COMMERCE_KILL_SWITCH=
# Site origin for success/cancel URLs, https only (https://www.agenticincome.ai).
COMMERCE_SITE_URL=
# Optional owned endpoint that sends the delivery email after a paid webhook.
# Called with Idempotency-Key: delivery:{transactionId}. Unset -> no email;
# the buyer still lands on the delivery page from the checkout success URL.
COMMERCE_DELIVERY_WEBHOOK_URL=

# --- Commerce: Stripe (COMMERCE_PROVIDER=stripe) ---------------------------
# Stripe opens only with private fulfillment configured: STRIPE_SECRET_KEY,
# COMMERCE_SITE_URL, STRIPE_WEBHOOK_SECRET, a KV pair, and
# COMMERCE_DELIVERY_WEBHOOK_URL. One-time SKUs only (recurring stays closed).
# Secret or restricted key (sk_/rk_, test first). Mark Sensitive in Vercel.
STRIPE_SECRET_KEY=
# `true` adds managed_payments[enabled]=true to each Checkout Session (Stripe
# Managed Payments; Stripe/Link is merchant of record). Anything else = plain
# Stripe Checkout, where tax is your own responsibility.
COMMERCE_STRIPE_MANAGED_PAYMENTS=
# Optional explicit price per SKU; otherwise the price is found by lookup key
# agenticincome.<sku>.<onetime|month>.usd.v1. Either way the Stripe amount and
# currency must equal the catalog or no session is created.
STRIPE_PRICE_ID_BLUEPRINT=
# Signing secret (whsec_) of the endpoint /api/webhooks/stripe. Sensitive.
STRIPE_WEBHOOK_SECRET=
# Durable idempotency + entitlement store (Upstash Redis via the Vercel
# Marketplace). Without one, /api/webhooks/stripe answers 503 (Stripe retries).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Equivalent names accepted when KV_* is unset:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Checkout path A: static checkout links (COMMERCE_PROVIDER=payment_link) --
# Used by GET /api/checkout via the payment_link adapter (`checkout.envKey` in
# lib/offers.ts). Paste the provider's checkout link per product. A link alone
# does NOT open checkout: COMMERCE_PROVIDER=payment_link and the catalog gate
# are also required. Missing -> the route redirects to request-access.
AGENTIC_INCOME_BLUEPRINT_CHECKOUT_URL=
AGENTIC_INCOME_PRIVATE_INTEL_CHECKOUT_URL=
AGENTIC_INCOME_AGENT_TEAM_PRO_CHECKOUT_URL=

# --- Checkout path B: Polar API sessions (COMMERCE_PROVIDER=polar) ---------
# Used by POST /api/checkout via lib/polar.ts. Creates a real checkout session
# per click, so the success URL is set from the catalog rather than baked into
# a copied link. See ops/POLAR-SETUP.md before setting any of these.
#
# Setting these alone does NOT open checkout: products/catalog.json `status`
# must also start with "for sale" for that product, and COMMERCE_PROVIDER must
# be `polar`. By design.

# Production remains the default. For local/test or Vercel preview only, set
# POLAR_SERVER=sandbox with distinct SANDBOX token and product IDs below.
# Sandbox is refused on Vercel production; credentials never fall back.
POLAR_SERVER=
POLAR_SANDBOX_ACCESS_TOKEN=
POLAR_SANDBOX_PRODUCT_ID_BLUEPRINT=
POLAR_SANDBOX_PRODUCT_ID_PRIVATE_INTEL=
POLAR_SANDBOX_PRODUCT_ID_AGENT_TEAM_PRO=
POLAR_SANDBOX_PRODUCT_ID_CLAIMS_GUARD_PACK=
POLAR_SANDBOX_PRODUCT_ID_ABOS_PACK_BUNDLE=
POLAR_SANDBOX_PRODUCT_ID_VIBE_OS_PACK=

# Organization Access Token (Polar dashboard -> Settings -> Developers).
# Server-side only. Never prefix with NEXT_PUBLIC_.
POLAR_ACCESS_TOKEN=

# One Polar product id per sellable catalog entry. The catalog-id -> env-var
# mapping lives in lib/polar.ts (PRODUCT_ID_ENV_KEYS); an unmapped product can
# never be checked out. `starter-kit` is absent on purpose — it is free.
#   blueprint       ($67 one-time)
POLAR_PRODUCT_ID_BLUEPRINT=
#   private-intel   ($19/mo subscription)
POLAR_PRODUCT_ID_PRIVATE_INTEL=
#   agent-team-pro  ($129 — do not set until the payload is assembled)
POLAR_PRODUCT_ID_AGENT_TEAM_PRO=
#   claims-guard-pack ($39 — do not set until the pack zip is assembled from
#   frankxai/agentic-business-os and uploaded to Polar)
POLAR_PRODUCT_ID_CLAIMS_GUARD_PACK=
#   abos-pack-bundle ($99 — do not set until the bundle zip is assembled from
#   frankxai/agentic-business-os and uploaded to Polar)
POLAR_PRODUCT_ID_ABOS_PACK_BUNDLE=
#   vibe-os-pack    ($24 — do not set until the pack zip is assembled from
#   frankxai/vibe-os and uploaded to Polar)
POLAR_PRODUCT_ID_VIBE_OS_PACK=

# Site origin used to build each product's success URL. The path comes from the
# catalog's own `delivery.path`, so buyers land on the delivery desk for the
# product they bought (e.g. https://agenticincome.ai/delivery/blueprint).
# Must be https. Unset -> Polar's own confirmation page is used.
POLAR_SUCCESS_URL=

