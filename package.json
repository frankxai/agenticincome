{
  "name": "agenticincome",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "description": "Agentic Income — implementation services, open systems, and practical products for building trustworthy AI revenue engines.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "audit:affiliate": "node scripts/audit-affiliate.mjs",
    "type-check": "tsc --noEmit",
    "links:check:static": "node scripts/check-internal-links.mjs",
    "verify:public": "node scripts/verify-public-surface.mjs",
    "schema:income-graph": "node scripts/gen-income-graph-schema.mjs",
    "merge:gate": "pnpm lint && pnpm test && pnpm type-check && pnpm links:check:static && pnpm verify:public && pnpm build",
    "predeploy": "npm run merge:gate && npm run sync:catalog"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "gsap": "^3.15.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "^16.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
